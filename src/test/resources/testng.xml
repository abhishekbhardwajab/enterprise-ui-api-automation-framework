<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ApiRegressionSuite" verbose="1">

    <!-- UI regression now runs via JUnit4 Cucumber runners (see tests/runners),
         selected through Surefire's runnerClass property - not through this
         suite file. This suite covers only the Rest Assured API layer, which
         sits outside the JUnit4/Cucumber scope described in the technical
         overview. Run with: mvn test -Papi -->

    <listeners>
        <listener class-name="com.automation.tests.listeners.RetryListener"/>
    </listeners>

    <test name="API-Regression">
        <classes>
            <class name="com.automation.tests.apiTests.UserApiTest"/>
        </classes>
    </test>

</suite>
